# Server port for Hono API
# Default: 8787 (avoids common dev port conflicts)
# Docker: Set via APP_PORT in docker-compose or .env
PORT=8787

# Security / encryption
# (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_KEY_ENCRYPTION_KEY=

# Set to true if behind a proxy like Nginx
TRUST_PROXY=false 

# Database
DATABASE_URL=sqlite://./data/chat.db

# Application URL (for CORS in production)
APP_URL=http://localhost:3000

# --- Trusted-header (forward proxy) auth, e.g. Authelia ---
# Off by default. When on, the password login UI is bypassed entirely and the
# reverse proxy is the sole source of identity — so the app MUST be unreachable
# except through that proxy.
PROXY_AUTH_ENABLED=false

# REQUIRED when enabled: IPs/CIDRs allowed to assert identity headers.
# Anything else is rejected even if the headers look valid. Use '*' only if the
# server is already network-isolated behind the proxy.
PROXY_AUTH_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Header carrying the identity. Set to Remote-Email to key accounts by email.
PROXY_AUTH_USER_HEADER=Remote-User
PROXY_AUTH_GROUPS_HEADER=Remote-Groups

# Admin mapping — set either, both, or neither.
# Configuring one makes the proxy authoritative: admin is granted and revoked on
# every request. With neither set, roles stay managed in the Admin Panel and the
# first provisioned user becomes admin.
PROXY_AUTH_ADMIN_GROUP=
PROXY_AUTH_ADMIN_USER=

# Create a local account the first time an identity is seen (default: true).
PROXY_AUTH_AUTO_PROVISION=true

# Where "Sign Out" sends the browser, e.g. https://auth.example.com/logout
PROXY_AUTH_LOGOUT_URL=